cppHeaderFileInclude {
	\.h$
	\.hpp$
	\.inc$
	\.inl$
}
cppSrcFileInclude {
	\.cpp$
}
modifiableFileExclude {
	CommandSwerveDrivetrain.(h|hpp|cpp)$
	TunerConstants.(h|hpp|cpp)$
	Telemetry.(h|hpp|cpp)$
	src/main/include/LimelightHelpers.h$
	src/main/deploy/*
	src/test/*
	gradle/*
	.json$
}
licenseUpdateExclude {
	RobotixLib.(h|hpp|cpp)$
	src/main/include/Configs.h$
}
