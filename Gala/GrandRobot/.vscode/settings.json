{
  "java.configuration.updateBuildConfiguration": "disabled",
  "java.import.gradle.enabled": false,
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "bin/": true,
    "**/.classpath": true,
    "**/.project": true,
    "**/.settings": true,
    "**/.factorypath": true,
    "**/*~": true
  },
	"C_Cpp.default.configurationProvider": "vscode-wpilib",
	"files.associations": {
		"iostream": "cpp",
		"array": "cpp",
		"xutility": "cpp",
		"deque": "cpp",
		"forward_list": "cpp",
		"list": "cpp",
		"vector": "cpp",
		"string_view": "cpp",
		"span": "cpp"
	}
}
